{
  "expo": {
    "name": "GadPortfolio",
    "slug": "gadportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E0E10"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "rw.ac.ines.a2526951.gadportfolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GadPortfolio needs access to your photos so you can set a profile picture or add a photo to your gallery.",
          "cameraPermission": "GadPortfolio needs camera access so you can take a profile picture or add a photo to your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "18f6bd54-6730-4d11-a2c0-07db878db8e0"
      }
    }
  }
}